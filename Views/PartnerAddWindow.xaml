<Window x:Class="WpfExamGrebenukov.Views.PartnerAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfExamGrebenukov.Views"
        mc:Ignorable="d"
        Title="PartnerAddWindow" Height="450" Width="800">
    <Grid Margin="10">
        <TextBlock FontSize="20" Margin="0 10 0 0" 
                   HorizontalAlignment="Center" Text="Добавление партнера"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15 15 15 0">
                <TextBlock Margin="0 15 0 0" Text="Наименование"/>
                <TextBox x:Name="titleTextBox" />
            
                <TextBlock Margin="0 15 0 0" Text="Тип партнера"/>
                <ComboBox x:Name="PartnersTypeComboBox" DisplayMemberPath="Title"
                          SelectedValuePath="PartnerTypeId"
                          SelectedValue="{Binding PartnerTypeId}"/>
            
                <TextBlock Margin="0 15 0 0" Text="Рейтинг"/>
                <TextBox x:Name="ratingTextBox"/>
            
                <TextBlock Margin="0 15 0 0" Text="ИНН"/>
                <TextBox x:Name="innTextBox" />
            
                <TextBlock Margin="0 15 0 0" Text="Address"/>
                <TextBox x:Name="addressTextBox" />
            
                <TextBlock Margin="0 15 0 0" Text="ФИО директора"/>
                <TextBox x:Name="directorTextBox" />
            
                <TextBlock Margin="0 15 0 0" Text="Телефон"/>
                <TextBox x:Name="phoneTextBox" />
            
                <TextBlock Margin="0 15 0 0" Text="Email"/>
                <TextBox x:Name="emailTextBox"/>
            
                <Button Content="Добавить" Click="AddButton_Click"></Button>
            
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</Window>
